pipeline {
    agent none
    stages {
        stage('Fase 1: Get Code') {
            agent { label 'agent1' }
            steps {
                // Borrar archivos viejos y empezar de cero
                sh 'echo "Agente: $(whoami) | $(hostname) | $WORKSPACE"'
                cleanWs()
                checkout scm
                stash name: 'code', includes: '**/*' 
            }
        }
    stage('Fase 2: Pip Check, Unit Tests, Rest Tests') {
        parallel {
          stage('Fase 2.1: Pip Check') {
          agent { label 'agent1' }
          steps {
            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                unstash 'code' 
                sh 'echo "Agente: $(whoami) | $(hostname) | $WORKSPACE"'
                sh '''
                    # Check dependencies of the installed pacakges
                    /Users/ahmeddabajagebara/anaconda3/envs/unir_devops/bin/pip check
                  '''
             }
           }
        }
        stage('Fase 2.2: Unit Tests') {
            agent { label 'agent2' }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    unstash 'code' 
                    sh 'echo "Agente: $(whoami) | $(hostname) | $WORKSPACE"'
                    sh '''
                        export PYTHONPATH=$WORKSPACE
                        /Users/ahmeddabajagebara/anaconda3/envs/unir_devops/bin/python -m pytest --junitxml=result-unit.xml test/unit
                    '''
                    junit 'result-unit.xml'
                }
            }
        }

        stage('Fase 2.3: Rest Tests') {
            agent { label 'agent3' }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    unstash 'code' 
                    sh 'echo "Agente: $(whoami) | $(hostname) | $WORKSPACE"'
                    sh '''
                        export PYTHONPATH=$WORKSPACE
                        export FLASK_APP=$WORKSPACE/app/api.py

                        # Start flask in background
                        /Users/ahmeddabajagebara/anaconda3/envs/unir_devops/bin/flask run --port 5001 & FLASK_PID=$!
                        
                        # Start wiremock
                        java -jar "$WORKSPACE/test/wiremock/wiremock-standalone-3.13.2.jar" --port 9090 --root-dir "$WORKSPACE/test/wiremock" & WM_PID=$!
                        
                        sleep 10

                        /Users/ahmeddabajagebara/anaconda3/envs/unir_devops/bin/python -m pytest --junitxml=result-rest.xml test/rest
                        
                        # Kill processes
                        kill $FLASK_PID
                        kill $WM_PID
                    '''
                    junit 'result-rest.xml'
                }
            }
        }
        }
    }
    stage('Fase 3: Quality Gates (coverage, static analysis, security)') {
        parallel {
        stage('Fase 3.1: Check Coverage') {
          agent { label 'agent1' }
          steps {
            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                unstash 'code' 
                sh 'echo "Agente: $(whoami) | $(hostname) | $WORKSPACE"'
                sh '''
                    export PYTHONPATH=$WORKSPACE
                    /Users/ahmeddabajagebara/anaconda3/envs/unir_devops/bin/coverage run \
                    --source=app --omit=app/__init__.py,app/api.py \
                    -m pytest test/unit
                    /Users/ahmeddabajagebara/anaconda3/envs/unir_devops/bin/coverage xml
                 '''
                recordCoverage(qualityGates: [[criticality: 'NOTE', metric: 'LINE', threshold: 95.0], [criticality: 'FAILURE', metric: 'LINE', threshold: 85.0], [criticality: 'NOTE', metric: 'BRANCH', threshold: 90.0], [criticality: 'FAILURE', metric: 'BRANCH', threshold: 80.0]], tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']])
             }
          }
       }

        stage('Fase 3.2: Static Analysis (Flake8)') {
            agent { label 'agent2' }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    unstash 'code' 
                    sh 'echo "Agente: $(whoami) | $(hostname) | $WORKSPACE"'
                    sh '/Users/ahmeddabajagebara/anaconda3/envs/unir_devops/bin/flake8 --format=pylint --exit-zero app > flake8.out'
                
                    // Clase 11 la forma vieja es usar unstable: true | false, ahora hay criticality: "UNSTABLE" | "FAILURE"
                    // recordIssues tools: [flake8(pattern: 'flake8.out')],
                    // qualityGates: [[unstable: true, threshold: 8, type: 'TOTAL'], [unstable: false, threshold: 10, type: 'TOTAL']
                    recordIssues(qualityGates: [[criticality: 'UNSTABLE', integerThreshold: 8, type: 'TOTAL'], [criticality: 'FAILURE', integerThreshold: 10, type: 'TOTAL']], tools: [flake8(pattern: 'flake8.out')])
                }
            }
        }

        stage('Fase 3.3: Security Scan (Bandit)') {
            agent { label 'agent3' }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    unstash 'code' 
                    sh 'echo "Agente: $(whoami) | $(hostname) | $WORKSPACE"'
                    sh '/Users/ahmeddabajagebara/anaconda3/envs/unir_devops/bin/bandit --exit-zero -r app -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}] {msg}"'
                    recordIssues(qualityGates: [[criticality: 'UNSTABLE', integerThreshold: 2, type: 'TOTAL'], [criticality: 'FAILURE', integerThreshold: 4, type: 'TOTAL']], tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')])
                }
            }
        }

        stage('Fase 3.4: Pip Audit') {
          agent { label 'agent3' }
          steps {
            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
               unstash 'code' 
               sh 'echo "Agente: $(whoami) | $(hostname) | $WORKSPACE"'
               sh '''
                  /Users/ahmeddabajagebara/anaconda3/envs/unir_devops/bin/pip-audit
                  '''
             }
           }
        }
        }
    }

        stage('Fase 4: Performance Test') {
            agent { label 'agent2' }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    unstash 'code' 
                    sh 'echo "Agente: $(whoami) | $(hostname) | $WORKSPACE"'
                    sh '''
                        export PYTHONPATH=$WORKSPACE
                        export FLASK_APP=$WORKSPACE/app/api.py
                        /Users/ahmeddabajagebara/anaconda3/envs/unir_devops/bin/flask run --port 5001 & FLASK_PID=$!

                        sleep 10

                        /opt/homebrew/bin/jmeter -n -t "$WORKSPACE/test/jmeter/flask.jmx" -l result-performance.jtl
                        kill $FLASK_PID
                    '''
                    perfReport sourceDataFiles: 'result-performance.jtl'
                }
            }
        }
    }
}
